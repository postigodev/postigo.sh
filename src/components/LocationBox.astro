---
import type { StoredLocation } from "../location/service";
import { getMoonPresentation } from "../location/celestial";
import { getWeatherPresentation } from "../location/weather";

interface Props {
  location: StoredLocation;
}

const { location } = Astro.props;
const place = `${location.city}, ${location.region ?? location.country}`;
const weather = location.weather
  ? getWeatherPresentation(location.weather.symbolCode)
  : null;
const now = new Date();
const moon = getMoonPresentation(now);
// Static artwork coordinates: crown, wings, roses, outer ornament.
const sparkles = [
  [596,62,3,7.1,-2.4], [650,120,6,8.3,-5.7], [568,175,2,6.7,-1.3],
  [704,180,3,9.1,-7.2], [167,86,6,8.7,-3.6], [99,253,2,7.6,-6.1],
  [447,109,3,9.7,-4.4], [1099,99,6,7.9,-1.9], [1176,278,2,10.1,-8.2],
  [815,132,3,8.9,-5.3], [242,682,3,9.3,-2.7], [1005,572,6,7.3,-4.9],
  [391,980,6,10.7,-8.6], [851,1010,3,8.1,-6.4], [615,1090,2,9.9,-3.1],
  [115,1041,3,7.7,-5.8], [1124,1101,6,10.3,-7.5],
];
const clockFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: location.timezone,
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false,
});
---

<aside
  class="location-box"
  aria-label="Current location and weather"
  data-location-box
  data-mobile-order
  data-timezone={location.timezone}
>
  <p class="location-kicker">currently posting from</p>
  <div class="location-frame">
    <div class="location-content">
      <p class="location-place">{place}</p>
      <div class="location-status">
        <time id="location-clock" datetime={now.toISOString()}
          >{clockFormatter.format(now)}</time
        >
      </div>
      <div class="location-meta">
        {
          weather && location.weather && (
            <div
              class="location-weather"
              data-weather-condition={weather.condition}
            >
              <picture>
                <source
                  media="(prefers-reduced-motion: reduce)"
                  srcset={weather.reducedMotionIconPath}
                />
                <img
                  class={`weather-icon weather-icon--${weather.motion}`}
                  src={weather.iconPath}
                  alt=""
                  width="24"
                  height="24"
                />
              </picture>
              <span class="weather-copy">
                {weather.condition} <span aria-hidden="true">·</span> {Math.round(location.weather.temperatureC)}°C
              </span>
            </div>
          )
        }
        <p class="location-moon">
          <span
            class={`moon-phase-icon moon-phase-icon--${moon.variant}`}
            aria-hidden="true"
          >
            <img src={moon.iconPath} alt="" width="16" height="16" />
          </span>
          <span id="moon-phase">{moon.label}</span>
        </p>
      </div>
    </div>
    <img class="location-angels" src="/images/weather/angels.png"
      alt="" aria-hidden="true" width="1254" height="1254" />
    <div class="location-sparkles" aria-hidden="true">
      {sparkles.map(([x, y, size, duration, delay]) => (
        <span class:list={["angel-sparkle", size > 3 ? "sparkle-star" : "sparkle-dot"]}
          style={`--x:${x / 1254 * 100}%;--y:${y / 1254 * 100}%;--size:${size}px;--duration:${duration}s;--delay:${delay}s`} />
      ))}
    </div>
  </div>
</aside>

<style>
  .location-box {
    --location-text: #ebe7e9;
    --location-muted: #c9c2c7;
    --location-accent: #9be8df;

    width: min(360px, 100%);
    align-self: center;
    box-sizing: border-box;
    color: var(--location-text);
    text-align: center;
    font-family: "Times New Roman", Georgia, serif;
    text-shadow:
      1px 1px 0 #111,
      -1px -1px 0 rgba(255, 255, 255, 0.12);
  }

  .location-frame {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1254 / 1254;
    container-type: inline-size;
    background:
      linear-gradient(rgba(244, 237, 218, 0.4), rgba(244, 237, 218, 0.4)),
      url("/images/weather/perlato-marble.png") center / cover no-repeat,
      #e6dfb7;
    box-shadow:
      inset 0 0 0 1px #718171,
      inset 0 0 0 2px #e6dfb7,
      inset 0 0 0 3px #a69a6b;
  }

  .location-frame::before {
    content: "";
    position: absolute;
    /* Marble and polish stay inside the measured oval, below the text. */
    left: 23.3%;
    top: 23.9%;
    width: 53.6%;
    height: 54.4%;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 32% 15%, rgba(255, 226, 185, 0.07), transparent 62%),
      linear-gradient(135deg, transparent 25%, rgba(255, 240, 211, 0.035) 42%, transparent 58%),
      linear-gradient(rgba(27, 16, 12, 0.82), rgba(27, 16, 12, 0.82)),
      url("/images/weather/dark-marble.png") center / cover no-repeat,
      #1b100c;
    box-shadow:
      inset 0 2px 8px rgba(0, 0, 0, 0.65),
      inset 0 0 0 1px rgba(221, 185, 125, 0.12);
    pointer-events: none;
  }

  .location-content {
    /* Measured transparent opening: x=292..964, y=300..982.
       Center text at (628,641), inside the curved rim. */
    position: absolute;
    z-index: 1;
    left: 50.08%;
    top: 51.12%;
    width: 46%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(3px, 1.3cqi, 5px);
    line-height: 1.15;
    transform: translate(-50%, -50%);
  }

  .location-angels, .location-frame::after, .location-sparkles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .location-angels {
    z-index: 2;
    object-fit: contain;
    filter:
      saturate(1.08) contrast(1.04) brightness(1.03)
      drop-shadow(0 0 3px rgba(255, 230, 170, 0.18))
      drop-shadow(0 0 7px rgba(255, 210, 120, 0.09));
    animation: angel-float 7s ease-in-out infinite;
  }
  .location-frame::after {
    content: "";
    z-index: 3;
    /* The PNG alpha confines the laminate to the artwork, leaving text clear. */
    mask: url("/images/weather/angels.png") center / contain no-repeat;
    background:
      linear-gradient(135deg,
        transparent 8%, rgba(255, 255, 255, 0.32) 19%, transparent 32%,
        rgba(255, 226, 247, 0.12) 47%, rgba(255, 255, 255, 0.2) 52%,
        transparent 66%, rgba(211, 244, 255, 0.15) 81%, transparent 92%);
    mix-blend-mode: screen;
    opacity: 0.7;
    animation: angel-float 7s ease-in-out infinite;
  }
  .location-sparkles { z-index: 4; }
  .angel-sparkle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    height: var(--size);
    opacity: 0;
    animation: angel-sparkle var(--duration) ease-in-out var(--delay) infinite;
  }
  .sparkle-dot {
    border-radius: 50%;
    background: rgba(255, 244, 190, 0.95);
    box-shadow: 0 0 3px rgba(255, 235, 150, 0.5);
  }
  .sparkle-star::before, .sparkle-star::after {
    content: "";
    position: absolute;
    background: rgba(255, 250, 220, 0.95);
    border-radius: 999px;
  }
  .sparkle-star::before { width: 1px; height: 100%; left: 50%; }
  .sparkle-star::after { height: 1px; width: 100%; top: 50%; }
  @keyframes angel-sparkle {
    0%, 25%, 85%, 100% { opacity: 0; transform: scale(0.45) translateY(1px); }
    40%, 70% { opacity: 0.2; }
    52% { opacity: 0.85; transform: scale(1) translateY(-1px); }
  }
  @keyframes angel-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .location-angels, .location-frame::after, .angel-sparkle { animation: none; }
    .angel-sparkle { opacity: 0.35; }
  }

  .location-box p {
    margin: 0;
  }

  .location-box .location-kicker {
    margin-bottom: 3px;
    color: var(--location-text);
    font-size: 11px;
    text-shadow: 0 1px 0 #111, 0 0 6px rgba(255, 244, 220, 0.28);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.1px;
    white-space: nowrap;
  }

  .location-place {
    max-width: 100%;
    color: var(--location-accent);
    font-size: clamp(16px, 7.1cqi, 26px);
    font-weight: 700;
    font-style: italic;
    letter-spacing: 0.3px;
    line-height: 1.05;
    overflow-wrap: anywhere;
    text-transform: lowercase;
    text-shadow:
      1px 1px 0 #111,
      0 0 5px rgba(155, 232, 223, 0.18);
  }

  .location-status {
    font-size: clamp(12px, 5cqi, 18px);
    font-weight: 400;
    letter-spacing: 0.5px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  #location-clock {
    display: block;
    width: 8ch;
  }

  .location-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(3px, 1cqi, 4px);
    margin-top: clamp(3px, 1.3cqi, 5px);
    color: var(--location-muted);
    font-size: clamp(9px, 3.6cqi, 13px);
    font-weight: 400;
    line-height: 1.2;
  }

  .location-weather,
  .location-moon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(3px, 1cqi, 4px);
  }

  .weather-copy {
    white-space: nowrap;
  }

  .location-weather picture,
  .weather-icon,
  .moon-phase-icon,
  .moon-phase-icon img {
    display: block;
    width: clamp(10px, 4cqi, 14px);
    height: clamp(10px, 4cqi, 14px);
    flex-shrink: 0;
    image-rendering: pixelated;
  }

  .weather-icon {
    filter: saturate(0.5);
    opacity: 0.8;
    transform-origin: center;
  }

  .weather-icon--twinkle {
    animation: weather-twinkle 1.6s steps(2, end) infinite;
  }
  .weather-icon--drift {
    animation: weather-drift 2.4s steps(3, end) infinite;
  }
  .weather-icon--fall {
    animation: weather-fall 1.2s steps(2, end) infinite;
  }
  .weather-icon--bounce {
    animation: weather-bounce 1s steps(2, end) infinite;
  }

  @keyframes weather-twinkle {
    50% {
      opacity: 0.72;
    }
  }
  @keyframes weather-drift {
    50% {
      transform: translateX(1px);
    }
  }
  @keyframes weather-fall {
    50% {
      transform: translateY(1px);
    }
  }
  @keyframes weather-bounce {
    50% {
      transform: translateY(-1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .weather-icon {
      animation: none;
    }
  }

  .moon-phase-icon {
    overflow: hidden;
  }
  .moon-phase-icon--new img {
    filter: brightness(0.2) saturate(0.6);
    opacity: 0.8;
  }
  .moon-phase-icon--waxing-crescent img,
  .moon-phase-icon--waxing-gibbous img {
    transform: scaleX(-1);
  }
  .moon-phase-icon--first-quarter img {
    clip-path: inset(0 0 0 50%);
  }
  .moon-phase-icon--last-quarter img {
    clip-path: inset(0 50% 0 0);
  }
</style>

<script>
  const locationBox = document.querySelector<HTMLElement>(
    "[data-location-box]",
  );
  const clock = locationBox?.querySelector<HTMLTimeElement>("#location-clock");
  const timezone = locationBox?.dataset.timezone;

  function updateClock() {
    if (!clock || !timezone) return;

    clock.textContent = new Intl.DateTimeFormat("en-US", {
      timeZone: timezone,
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    }).format(new Date());
    clock.dateTime = new Date().toISOString();
  }

  updateClock();
  window.setInterval(updateClock, 1000);
</script>
