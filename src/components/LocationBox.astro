---
import type { StoredLocation } from "../location/service";
import { getDayPeriod, getMoonPresentation } from "../location/celestial";
import { getWeatherPresentation } from "../location/weather";

interface Props {
  location: StoredLocation;
}

const { location } = Astro.props;
const place = `${location.city}, ${location.region ?? location.country}`;
const weather = location.weather
  ? getWeatherPresentation(location.weather.symbolCode)
  : null;
const now = new Date();
const dayPeriod = getDayPeriod(now, location.timezone);
const moon = getMoonPresentation(now);
// Static artwork coordinates: crown, wings, roses, outer ornament.
const sparkles = [
  [596,62,3,7.1,-2.4], [650,120,6,8.3,-5.7], [568,175,2,6.7,-1.3],
  [704,180,3,9.1,-7.2], [167,86,6,8.7,-3.6], [99,253,2,7.6,-6.1],
  [447,109,3,9.7,-4.4], [1099,99,6,7.9,-1.9], [1176,278,2,10.1,-8.2],
  [815,132,3,8.9,-5.3], [242,682,3,9.3,-2.7], [1005,572,6,7.3,-4.9],
  [391,980,6,10.7,-8.6], [851,1010,3,8.1,-6.4], [615,1090,2,9.9,-3.1],
  [115,1041,3,7.7,-5.8], [1124,1101,6,10.3,-7.5],
];
const clockFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: location.timezone,
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false,
});
---

<aside
  class="location-box"
  aria-label="Current location and weather"
  data-location-box
  data-mobile-order
  data-timezone={location.timezone}
>
  <p class="location-kicker">currently posting from</p>
  <div class="location-frame">
    <div class="location-content">
  <p class="location-place">{place}</p>
  <div class="location-box-flex">
    <div class="location-status">
      <span class="status-item">
        <span
          class="time-effect"
          data-time-effect="day"
          hidden={dayPeriod !== "day"}
          aria-hidden="true"
        >
          <picture
            ><source
              media="(prefers-reduced-motion: reduce)"
              srcset="/images/weather/spark-burst-static.svg"
            /><img
              src="/images/weather/spark-burst.svg"
              alt=""
              width="18"
              height="18"
            /></picture
          >
        </span>
        <span
          class="time-effect"
          data-time-effect="night"
          hidden={dayPeriod !== "night"}
          aria-hidden="true"
        >
          <picture
            ><source
              media="(prefers-reduced-motion: reduce)"
              srcset="/images/weather/pixel-rain-static.svg"
            /><img
              src="/images/weather/pixel-rain.svg"
              alt=""
              width="18"
              height="18"
            /></picture
          >
        </span>
        <time id="location-clock" datetime={now.toISOString()}
          >{clockFormatter.format(now)}</time
        >
      </span>
    </div>
    <span>★</span>
    {
      weather && location.weather && (
        <div
          class="location-weather"
          data-weather-condition={weather.condition}
        >
          <span class="weather-copy">
            <span>{weather.condition}</span>
            <span>{Math.round(location.weather.temperatureC)}°C</span>
          </span>
          <picture>
            <source
              media="(prefers-reduced-motion: reduce)"
              srcset={weather.reducedMotionIconPath}
            />
            <img
              class={`weather-icon weather-icon--${weather.motion}`}
              src={weather.iconPath}
              alt=""
              width="24"
              height="24"
            />
          </picture>
          
        </div>
      )
    }
  </div>
  <p class="location-moon">
    <span
      class={`moon-phase-icon moon-phase-icon--${moon.variant}`}
      aria-hidden="true"
    >
      <img src={moon.iconPath} alt="" width="16" height="16" />
    </span>
    <span id="moon-phase">{moon.label}</span>
  </p>
    </div>
    <img class="location-angels" src="/images/weather/angels.png"
      alt="" aria-hidden="true" width="1254" height="1254" />
    <div class="location-sparkles" aria-hidden="true">
      {sparkles.map(([x, y, size, duration, delay]) => (
        <span class:list={["angel-sparkle", size > 3 ? "sparkle-star" : "sparkle-dot"]}
          style={`--x:${x / 1254 * 100}%;--y:${y / 1254 * 100}%;--size:${size}px;--duration:${duration}s;--delay:${delay}s`} />
      ))}
    </div>
  </div>
</aside>

<style>
  .location-box {
    --location-text: #ebe7e9;
    --location-muted: #c9c2c7;
    --location-accent: #9be8df;

    width: min(360px, 100%);
    align-self: center;
    box-sizing: border-box;
    color: var(--location-text);
    text-align: center;
    font-family: "Times New Roman", Georgia, serif;
    text-shadow:
      1px 1px 0 #111,
      -1px -1px 0 rgba(255, 255, 255, 0.12);
  }

  .location-frame {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1254 / 1254;
    container-type: inline-size;
  }

  .location-frame::before {
    content: "";
    position: absolute;
    /* Retain the original backing only inside the measured oval. */
    left: 23.3%;
    top: 23.9%;
    width: 53.6%;
    height: 54.4%;
    border-radius: 50%;
    background: rgba(49, 38, 42, 0.92);
  }

  .location-content {
    /* Measured transparent opening: x=292..964, y=300..982.
       Center text at (628,641), inside the curved rim. */
    position: absolute;
    z-index: 1;
    left: 50.08%;
    top: 51.12%;
    width: 49%;
    transform: translate(-50%, -50%);
  }

  .location-angels, .location-sparkles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .location-angels {
    z-index: 2;
    object-fit: contain;
    animation: angel-float 7s ease-in-out infinite;
  }
  .location-sparkles { z-index: 3; }
  .angel-sparkle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    height: var(--size);
    opacity: 0;
    animation: angel-sparkle var(--duration) ease-in-out var(--delay) infinite;
  }
  .sparkle-dot {
    border-radius: 50%;
    background: rgba(255, 244, 190, 0.95);
    box-shadow: 0 0 3px rgba(255, 235, 150, 0.5);
  }
  .sparkle-star::before, .sparkle-star::after {
    content: "";
    position: absolute;
    background: rgba(255, 250, 220, 0.95);
    border-radius: 999px;
  }
  .sparkle-star::before { width: 1px; height: 100%; left: 50%; }
  .sparkle-star::after { height: 1px; width: 100%; top: 50%; }
  @keyframes angel-sparkle {
    0%, 25%, 85%, 100% { opacity: 0; transform: scale(0.45) translateY(1px); }
    40%, 70% { opacity: 0.2; }
    52% { opacity: 0.85; transform: scale(1) translateY(-1px); }
  }
  @keyframes angel-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .location-angels, .angel-sparkle { animation: none; }
    .angel-sparkle { opacity: 0.35; }
  }

  .location-box p {
    margin: 0;
  }

  .location-kicker {
    margin-bottom: 1px !important;
    color: var(--location-text);
    font-size: 12px;
    font-weight: 700;
    font-style: italic;
    letter-spacing: 0.9px;
  }

  .location-place {
    margin-bottom: 7px !important;
    color: var(--location-accent);
    font-size: 16px;
    font-weight: 700;
    font-style: italic;
    letter-spacing: 1.8px;
    line-height: 1.05;
    text-transform: lowercase;
    text-shadow:
      1px 1px 0 #111,
      0 0 5px rgba(155, 232, 223, 0.18);
  }

  .location-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    justify-self: start;
  }
  .location-box-flex {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    width: 100%;
  }
  .location-box-flex > span {
    justify-self: center;
  }
  .location-weather {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: -1px 0 6px;
    color: var(--location-text);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.45px;
    justify-self: end;
  }

  .location-weather picture,
  .weather-icon {
    display: block;
    width: 24px;
    height: 24px;
  }

  .weather-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1;
  }

  .weather-icon {
    image-rendering: pixelated;
    transform-origin: center;
  }

  .weather-icon--twinkle {
    animation: weather-twinkle 1.6s steps(2, end) infinite;
  }
  .weather-icon--drift {
    animation: weather-drift 2.4s steps(3, end) infinite;
  }
  .weather-icon--fall {
    animation: weather-fall 1.2s steps(2, end) infinite;
  }
  .weather-icon--bounce {
    animation: weather-bounce 1s steps(2, end) infinite;
  }

  @keyframes weather-twinkle {
    50% {
      opacity: 0.72;
    }
  }
  @keyframes weather-drift {
    50% {
      transform: translateX(1px);
    }
  }
  @keyframes weather-fall {
    50% {
      transform: translateY(1px);
    }
  }
  @keyframes weather-bounce {
    50% {
      transform: translateY(-1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .weather-icon {
      animation: none;
    }
  }

  .status-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }

  .time-effect,
  .time-effect picture,
  .time-effect img {
    display: block;
    width: 18px;
    height: 18px;
    image-rendering: pixelated;
  }

  .time-effect[hidden] {
    display: none;
  }

  .location-moon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    color: var(--location-muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
  }

  .moon-phase-icon,
  .moon-phase-icon img {
    display: block;
    width: 16px;
    height: 16px;
    image-rendering: pixelated;
  }

  .moon-phase-icon {
    overflow: hidden;
  }
  .moon-phase-icon--new img {
    filter: brightness(0.2) saturate(0.6);
    opacity: 0.8;
  }
  .moon-phase-icon--waxing-crescent img,
  .moon-phase-icon--waxing-gibbous img {
    transform: scaleX(-1);
  }
  .moon-phase-icon--first-quarter img {
    clip-path: inset(0 0 0 50%);
  }
  .moon-phase-icon--last-quarter img {
    clip-path: inset(0 50% 0 0);
  }

  /* Fit the existing row into the narrow desktop oval without shrinking type. */
  @container (max-width: 330px) {
    .location-box-flex { display: flex; flex-direction: column; align-items: center; }
    .location-box-flex > span { display: none; }
    .location-status, .location-weather { margin: 0 0 2px; }
    .location-place { margin-bottom: 2px !important; }
    .location-moon { line-height: 1.1; }
  }
</style>

<script>
  const locationBox = document.querySelector<HTMLElement>(
    "[data-location-box]",
  );
  const clock = locationBox?.querySelector<HTMLTimeElement>("#location-clock");
  const timezone = locationBox?.dataset.timezone;
  const effects =
    locationBox?.querySelectorAll<HTMLElement>("[data-time-effect]");

  function updateClock() {
    if (!clock || !timezone) return;

    clock.textContent = new Intl.DateTimeFormat("en-US", {
      timeZone: timezone,
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    }).format(new Date());
    clock.dateTime = new Date().toISOString();

    const hour = Number(
      new Intl.DateTimeFormat("en-US", {
        timeZone: timezone,
        hour: "numeric",
        hourCycle: "h23",
      }).format(new Date()),
    );
    const period = hour >= 6 && hour < 18 ? "day" : "night";
    effects?.forEach((effect) => {
      effect.hidden = effect.dataset.timeEffect !== period;
    });
  }

  updateClock();
  window.setInterval(updateClock, 1000);
</script>
