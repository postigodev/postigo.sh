---
import type { StoredLocation } from '../location/service';
import { getDayPeriod, getMoonPresentation } from '../location/celestial';
import { getWeatherPresentation } from '../location/weather';

interface Props {
  location: StoredLocation;
}

const { location } = Astro.props;
const place = `${location.city}, ${location.region ?? location.country}`;
const weather = location.weather
  ? getWeatherPresentation(location.weather.symbolCode)
  : null;
const now = new Date();
const dayPeriod = getDayPeriod(now, location.timezone);
const moon = getMoonPresentation(now);
const clockFormatter = new Intl.DateTimeFormat('en-US', {
  timeZone: location.timezone,
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
  hour12: false,
});

---

<aside
  class="location-box"
  aria-label="Current location and weather"
  data-location-box
  data-mobile-order
  data-timezone={location.timezone}
>
  <p class="location-kicker">currently posting from</p>
  <p class="location-place">{place}</p>

  <div class="location-status">
    <span class="status-item">
      <span class="time-effect" data-time-effect="day" hidden={dayPeriod !== 'day'} aria-hidden="true">
        <picture><source media="(prefers-reduced-motion: reduce)" srcset="/images/weather/spark-burst-static.svg" /><img src="/images/weather/spark-burst.svg" alt="" width="18" height="18" /></picture>
      </span>
      <span class="time-effect" data-time-effect="night" hidden={dayPeriod !== 'night'} aria-hidden="true">
        <picture><source media="(prefers-reduced-motion: reduce)" srcset="/images/weather/pixel-rain-static.svg" /><img src="/images/weather/pixel-rain.svg" alt="" width="18" height="18" /></picture>
      </span>
      <time id="location-clock" datetime={now.toISOString()}>{clockFormatter.format(now)}</time>
    </span>
  </div>

  {weather && location.weather && (
    <div class="location-weather" data-weather-condition={weather.condition}>
      <picture>
        <source
          media="(prefers-reduced-motion: reduce)"
          srcset={weather.reducedMotionIconPath}
        />
        <img
          class={`weather-icon weather-icon--${weather.motion}`}
          src={weather.iconPath}
          alt=""
          width="24"
          height="24"
        />
      </picture>
      <span class="weather-copy">
        <span>{weather.condition}</span>
        <span>{Math.round(location.weather.temperatureC)}°C</span>
      </span>
    </div>
  )}

  <p class="location-moon">
    <span class={`moon-phase-icon moon-phase-icon--${moon.variant}`} aria-hidden="true">
      <img src={moon.iconPath} alt="" width="16" height="16" />
    </span>
    <span id="moon-phase">{moon.label}</span>
  </p>
</aside>

<style>
  .location-box {
    --location-bg: rgba(49, 38, 42, 0.92);
    --location-border: rgba(235, 238, 244, 0.9);
    --location-text: #ebe7e9;
    --location-muted: #c9c2c7;
    --location-accent: #9be8df;

    width: min(260px, 100%);
    box-sizing: border-box;
    padding: 10px 14px 11px;
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.035),
        rgba(0, 0, 0, 0.08)
      ),
      var(--location-bg);
    border: 1px dashed var(--location-border);
    border-radius: 7px;
    color: var(--location-text);
    text-align: center;
    box-shadow:
      0 2px 0 rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(4px);
    font-family: "Times New Roman", Georgia, serif;
    text-shadow:
      1px 1px 0 #111,
      -1px -1px 0 rgba(255, 255, 255, 0.12);
  }

  .location-box p {
    margin: 0;
  }

  .location-kicker {
    margin-bottom: 1px !important;
    color: var(--location-text);
    font-size: 12px;
    font-weight: 700;
    font-style: italic;
    letter-spacing: 0.9px;
  }

  .location-place {
    margin-bottom: 7px !important;
    color: var(--location-accent);
    font-size: 16px;
    font-weight: 700;
    font-style: italic;
    letter-spacing: 1.8px;
    line-height: 1.05;
    text-transform: lowercase;
    text-shadow:
      1px 1px 0 #111,
      0 0 5px rgba(155, 232, 223, 0.18);
  }

  .location-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .location-weather {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: -1px 0 6px;
    color: var(--location-text);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.45px;
  }

  .location-weather picture,
  .weather-icon {
    display: block;
    width: 24px;
    height: 24px;
  }

  .weather-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.05;
  }

  .weather-icon {
    image-rendering: pixelated;
    transform-origin: center;
  }

  .weather-icon--twinkle { animation: weather-twinkle 1.6s steps(2, end) infinite; }
  .weather-icon--drift { animation: weather-drift 2.4s steps(3, end) infinite; }
  .weather-icon--fall { animation: weather-fall 1.2s steps(2, end) infinite; }
  .weather-icon--bounce { animation: weather-bounce 1s steps(2, end) infinite; }

  @keyframes weather-twinkle { 50% { opacity: 0.72; } }
  @keyframes weather-drift { 50% { transform: translateX(1px); } }
  @keyframes weather-fall { 50% { transform: translateY(1px); } }
  @keyframes weather-bounce { 50% { transform: translateY(-1px); } }

  @media (prefers-reduced-motion: reduce) {
    .weather-icon { animation: none; }
  }

  .status-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }

  .time-effect,
  .time-effect picture,
  .time-effect img {
    display: block;
    width: 18px;
    height: 18px;
    image-rendering: pixelated;
  }

  .time-effect[hidden] {
    display: none;
  }

  .location-moon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    color: var(--location-muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
  }

  .moon-phase-icon,
  .moon-phase-icon img {
    display: block;
    width: 16px;
    height: 16px;
    image-rendering: pixelated;
  }

  .moon-phase-icon { overflow: hidden; }
  .moon-phase-icon--new img { filter: brightness(0.2) saturate(0.6); opacity: 0.8; }
  .moon-phase-icon--waxing-crescent img,
  .moon-phase-icon--waxing-gibbous img { transform: scaleX(-1); }
  .moon-phase-icon--first-quarter img { clip-path: inset(0 0 0 50%); }
  .moon-phase-icon--last-quarter img { clip-path: inset(0 50% 0 0); }

  @media (max-width: 420px) {
    .location-box {
      width: 100%;
    }
  }
</style>

<script>
  const locationBox = document.querySelector<HTMLElement>('[data-location-box]');
  const clock = locationBox?.querySelector<HTMLTimeElement>('#location-clock');
  const timezone = locationBox?.dataset.timezone;
  const effects = locationBox?.querySelectorAll<HTMLElement>('[data-time-effect]');

  function updateClock() {
    if (!clock || !timezone) return;

    clock.textContent = new Intl.DateTimeFormat('en-US', {
      timeZone: timezone,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    }).format(new Date());
    clock.dateTime = new Date().toISOString();

    const hour = Number(new Intl.DateTimeFormat('en-US', {
      timeZone: timezone,
      hour: 'numeric',
      hourCycle: 'h23',
    }).format(new Date()));
    const period = hour >= 6 && hour < 18 ? 'day' : 'night';
    effects?.forEach((effect) => { effect.hidden = effect.dataset.timeEffect !== period; });
  }

  updateClock();
  window.setInterval(updateClock, 1000);
</script>
