---
import GitHubWidget from "./GitHubWidget";
import NowPlayingWidget from "./NowPlayingWidget";
import SiteModule from "./SiteModule.astro";
import { identity, projectCases, selectedWork } from "../data/portfolio";
import { resumeContent } from "../data/siteContent";
import type { WritingSummary } from "../data/writings";
import ProjectWindowLayer from "../project-windows/ProjectWindowLayer";

interface Props {
  initialProjectSlug?: string;
  writings?: readonly WritingSummary[];
  writingsAvailable?: boolean;
}
const { initialProjectSlug, writings = [], writingsAvailable } = Astro.props;
---

<div class="site-page" data-home-surface>
  <header class="site-head">
    <div class="site-head__identity">
      <a class="wordmark" href="/">postigo.sh</a>
      <div class="head-links">
        <a href="/">home</a> · <a href="/about">profile</a>
      </div>
    </div>
    <p class="ticker-window">
      <span class="sr-only"
        >{identity.primaryIdentity}. {identity.descriptor}. {
          identity.thesis
        }</span
      >
      <span class="ticker-track" aria-hidden="true">
        {identity.primaryIdentity} · {identity.descriptor} · {identity.thesis} &nbsp;
        ◆ &nbsp;
        {identity.primaryIdentity} · {identity.descriptor} · {identity.thesis}
      </span>
    </p>
    <div class="site-head__goat">
      <img
        src="/images/site/goat_rotation.gif"
        width="80"
        height="80"
        alt="Goat, the postigo.sh site mascot"
      />
      <span>@me</span>
    </div>
  </header>

  <div class="site-grid">
    <main class="site-column site-column--main">
      <SiteModule id="welcome" title="hero" column="main" hero>
        <h1>{identity.primaryIdentity}</h1>
        <p class="hero-name">{identity.name}</p>
        <p>{identity.descriptor}</p>
        <p>{identity.thesis}</p>
        <a class="hero-action" href="/work">Explore selected work</a>
        <img
          class="floating-goat"
          src="/images/site/goat-explaining.webp"
          width="80"
          height="80"
          alt=""
        />
        <span class="tiny-caption tech-icons" aria-label="Core technologies">
          <img
            src="/images/techs/typescript.png"
            width="14"
            height="14"
            alt="TypeScript"
          />
          <img
            src="/images/techs/python.png"
            width="14"
            height="14"
            alt="Python"
          />
          <img src="/images/techs/rust.png" width="14" height="14" alt="Rust" />
        </span>
      </SiteModule>

      <SiteModule id="projects" title="projects" column="main">
        <ol class="project-list">
          {
            selectedWork.map((project) => (
              <li data-selected-project>
                <>
                  <a data-project-launcher href={`/work/${project.slug}`}>
                    {project.name}
                  </a>
                  <span>
                    {project.signal} · {project.status}
                  </span>
                </>
              </li>
            ))
          }
        </ol>
      </SiteModule>

      <SiteModule id="writings-box" title="writings" column="main">
        {
          writingsAvailable === undefined ? (
            <p class="empty-state">
              <>
                <strong>Writing availability is checked live.</strong>
                <span>
                  Open the writings page for the current publication status.
                </span>
              </>
            </p>
          ) : !writingsAvailable ? (
            <p class="empty-state">
              <>
                <strong>Writings are temporarily unavailable.</strong>
                <span>The rest of the portfolio remains available.</span>
              </>
            </p>
          ) : writings.length > 0 ? (
            <ol class="writing-list">
              {writings.map((writing) => (
                <li>
                  <a href={`/writings/${writing.slug}`}>{writing.title}</a>
                  <span>{writing.summary}</span>
                </li>
              ))}
            </ol>
          ) : (
            <p class="empty-state">
              <>
                <strong>No published writing yet.</strong>
                <span>
                  This section is under construction; no placeholder essays are
                  listed.
                </span>
              </>
            </p>
          )
        }
        <a class="open-writings" href="/writings">Open writings</a>
      </SiteModule>

      <SiteModule id="github-box" title="github activity" column="main"
        ><GitHubWidget client:load /></SiteModule
      >
    </main>

    <aside
      class="site-column site-column--left"
      aria-label="Profile and navigation"
    >
      <SiteModule id="profile-card" title="profile card" column="left">
        <img
          src="/images/site/goat-profile-2.webp"
          width="80"
          height="80"
          alt="Goat, the postigo.sh site mascot"
        />
        <div class="profile-lines">
          <strong>{identity.name}</strong><br />{identity.primaryIdentity}<br
          />{identity.descriptor}<br /><br /><span class="mini-online"
            >● public profile</span
          >
        </div>
      </SiteModule>

      <SiteModule id="directory" title="navigation" column="left">
        <div class="primary-links">
          <a href="/">home</a><a href="/about">profile</a>
        </div>
        <p class="nav-group-title">on-site</p>
        <nav class="nav-group" aria-label="On-site">
          <a href="/work">projects</a><a href="/writings">writings</a><a
            href="#album">photo album</a
          ><a href="#github-box">github activity</a><a href="/resume">resume</a>
        </nav>
        <p class="nav-group-title">for you</p>
        <nav class="nav-group" aria-label="For visitors">
          <a href="/about">about</a><a href="/contact">contact</a><a
            href="/privacy">privacy</a
          >
        </nav>
      </SiteModule>

      <SiteModule id="note-box" title="note" column="left"
        ><p>{identity.thesis}</p></SiteModule
      >

      <SiteModule id="links-box" title="links" column="left">
        <div class="links-list">
          <a href={identity.links.github}>github</a><a
            href={identity.links.linkedin}>linkedin</a
          ><a href={identity.links.email}>email</a><a href="/resume">resume</a>
        </div>
      </SiteModule>

      <SiteModule id="resume-box" title="resume" column="left">
        <div class="resume-snippet">
          <strong>{resumeContent.paragraphs[0]}</strong><br /><br /><a
            href="/resume">view full resume</a
          >
        </div>
      </SiteModule>
    </aside>

    <aside
      class="site-column site-column--right"
      aria-label="Presence and utilities"
    >
      <SiteModule id="latest" title="now playing" column="right"
        ><NowPlayingWidget client:load /></SiteModule
      >

      <SiteModule id="album" title="photo album" column="right">
        <div class="album-empty" aria-label="Photo album under construction">
          <span aria-hidden="true">NO PHOTOS</span><strong
            >Photo album under construction.</strong
          ><p>No images have been published here yet.</p>
        </div>
      </SiteModule>

      <SiteModule id="updates-mini" title="selected work status" column="right">
        <ol class="activity-list">
          {
            selectedWork.slice(0, 3).map((project) => (
              <li>
                <>
                  <a data-project-launcher href={`/work/${project.slug}`}>
                    {project.name}
                  </a>
                  <span>{project.status}</span>
                </>
              </li>
            ))
          }
        </ol>
      </SiteModule>
    </aside>
  </div>

  <div class="critter-lane" aria-hidden="true">
    <img src="/images/site/roflneko.gif" width="80" height="80" alt="" /><span
      >↑ site creature</span
    >
  </div>
  <footer class="site-footer">
    postigo.sh · {identity.primaryIdentity} · <a href="/privacy">privacy</a>
  </footer>
</div>
<ProjectWindowLayer
  projects={projectCases}
  initialSlugs={initialProjectSlug ? [initialProjectSlug] : []}
  client:load
/>
