---
import '../styles/global.css';
import type { WritingMetadata } from '../writings/metadata';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  openGraph?: WritingMetadata['openGraph'];
  jsonLd?: WritingMetadata['jsonLd'];
  citation?: {
    title: string;
    authors: readonly string[];
    publicationDate?: string;
    pdfUrl?: string;
  };
}

const {
  title,
  description,
  canonicalUrl,
  openGraph,
  jsonLd,
  citation,
} = Astro.props;
const serializedJsonLd = jsonLd
  ? JSON.stringify(jsonLd).replaceAll('<', '\\u003c')
  : undefined;
const directionContract = `<!--
THESIS: A maintained personal web desktop makes professional evidence immediately legible and refuses the generic portfolio hero-card stack.
OWN-WORLD: Dark blue, violet, cyan, and acid-green modules use compact Tahoma type, metallic gradient titlebars, hard borders, and the embedded goat signature.
STORY: Visitors identify Piero as a software engineer, scan selected work, then follow stable routes or public presence links.
FIRST VIEWPORT: A 952px three-column desktop opens with the identity header above navigation, a dominant engineering hero, selected work, and live presence; Work is the primary path.
FORM: Preview-native personal homepage, chosen pinned direction, seed e23380ff.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {openGraph && (
      <>
        <meta property="og:type" content={openGraph.type} />
        <meta property="og:title" content={openGraph.title} />
        <meta property="og:description" content={openGraph.description} />
        <meta property="og:url" content={openGraph.url} />
        <meta property="og:locale" content={openGraph.locale} />
        <meta property="article:modified_time" content={openGraph.modifiedTime} />
        {openGraph.publishedTime && <meta property="article:published_time" content={openGraph.publishedTime} />}
        {openGraph.image && <meta property="og:image" content={openGraph.image} />}
      </>
    )}
    {citation && (
      <>
        <meta name="citation_title" content={citation.title} />
        {citation.authors.map((author) => <meta name="citation_author" content={author} />)}
        {citation.publicationDate && <meta name="citation_publication_date" content={citation.publicationDate} />}
        {citation.pdfUrl && <meta name="citation_pdf_url" content={citation.pdfUrl} />}
      </>
    )}
    {serializedJsonLd && <script is:inline type="application/ld+json" set:html={serializedJsonLd} />}
    <title>{title}</title>
  </head>
  <body><Fragment set:html={directionContract} /><slot /></body>
</html>
