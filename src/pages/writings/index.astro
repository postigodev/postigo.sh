---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocumentNav from '../../components/DocumentNav.astro';
import { getPublishedWritings } from '../../data/writings';

const writings = getPublishedWritings();
---
<BaseLayout title="Writings | Piero Postigo Rocchetti" description="Published writing by Piero Postigo Rocchetti.">
  <main class="document-shell">
    <DocumentNav />
    <article class="document-panel">
      <h1>Writings</h1>
      {writings.length > 0
        ? <ol>{writings.map((writing) => <li><a href={`/writings/${writing.slug}`}>{writing.title}</a><p>{writing.summary}</p></li>)}</ol>
        : <p class="empty-state"><strong>No published writing yet.</strong><span>This section is under construction.</span></p>}
    </article>
  </main>
</BaseLayout>
