{
  "name": "portfolio-v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "serve dist --no-clipboard",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:functions": "vitest run tests/functions",
    "test:e2e:functions": "playwright test tests/e2e/presence-api.spec.ts --config=playwright.vercel.config.ts",
    "dev:vercel": "node scripts/vercel-local-dev.mjs",
    "spotify:bootstrap": "node scripts/spotify-bootstrap.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.2",
    "astro": "7.2.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "serve": "14.2.6",
    "typescript": "6.0.3",
    "vercel": "58.11.0",
    "vitest": "4.1.10"
  }
}
